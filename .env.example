NEURALDOC_ENV=development
NEURALDOC_DATABASE_URL=sqlite:///./data/neuraldoc.db
NEURALDOC_INDEX_DIR=./data/indices
NEURALDOC_UPLOAD_DIR=./data/uploads
NEURALDOC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEURALDOC_CHUNK_SIZE=800
NEURALDOC_CHUNK_OVERLAP=120
NEURALDOC_TOP_K=5
# Optional LLM (LangChain) — leave empty for fully-local extractive QA
OPENAI_API_KEY=
